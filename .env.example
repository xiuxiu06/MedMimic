# Copy to .env.local and fill in. Never commit real keys.
GEMINI_API_KEY=

# Supabase (Auth + PostgreSQL Database — works seamlessly with Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth0 (branch b/s8-auth0) — see AUTH0_SETUP.md
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
