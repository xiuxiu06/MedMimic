# Copy to .env.local and fill in. Never commit real keys.
GEMINI_API_KEY=

# Supabase (PostgreSQL database; auth comes from Auth0 via Third-Party Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth0 login — see AUTH0_SETUP.md. Leave blank to run in guest mode.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
